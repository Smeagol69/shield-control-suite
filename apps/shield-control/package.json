{
  "name": "shield-control",
  "productName": "Shield Control",
  "version": "1.2.0",
  "description": "Desktop control center for NVIDIA Shield TV over adb — screen control, file transfer, APK install.",
  "author": "roesler",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && npm test",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "dev.roesler.shieldcontrol",
    "productName": "Shield Control",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*",
          "!platform-tools/fastboot.exe",
          "!platform-tools/mke2fs.exe",
          "!platform-tools/make_f2fs.exe",
          "!platform-tools/make_f2fs_casefold.exe",
          "!platform-tools/etc1tool.exe",
          "!platform-tools/hprof-conv.exe",
          "!platform-tools/sqlite3.exe",
          "!scrcpy/adb.exe"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Smeagol69",
        "repo": "shield-control-suite",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Shield-Control-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ShieldControl-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
